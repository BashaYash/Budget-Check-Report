<mvc:View
    controllerName="com.onex.budgetcheck.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizdata="sap.viz.ui5.data"
    xmlns:vizfeed="sap.viz.ui5.controls.common.feeds"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns="sap.m">

    <Page id="page" title="{i18n>title}">
        <content>

            <HBox
                class="sapUiMediumMargin"
                alignItems="Center"
                justifyContent="Start"
                wrap="Wrap"
                renderType="Bare">

                <VBox class="sapUiSmallMarginEnd">
                    <Label text="Company Code" />
                    <MultiInput
                        id="companyCodeInput"
                        placeholder="Company Code"
                        width="260px"
                        showValueHelp="true"
                        valueHelpRequest=".onCompanyCodeValueHelp" />
                </VBox>

                <VBox class="sapUiSmallMarginEnd">
                    <Label text="Cost Center" />
                    <MultiInput
                        id="costCenterInput"
                        placeholder="Cost Center"
                        width="260px"
                        showValueHelp="true"
                        valueHelpRequest=".onCostCenterValueHelp" />
                </VBox>

                <VBox class="sapUiSmallMarginEnd">
                    <Label text="Department (optional)" />
                    <Input
                        id="departmentInput"
                        placeholder="Department"
                        width="180px"
                        showValueHelp="true"
                        valueHelpRequest=".onDepartmentValueHelp" />
                </VBox>

                <Button
                    text="Submit"
                    type="Emphasized"
                    press=".onSubmit"
                    class="sapUiSmallMarginTop" />

            </HBox>

            <!-- Pie chart and Bar chart side by side, RESPONSIVE via sap.ui.layout.-->
            <l:Grid
                defaultSpan="L6 M12 S12"
                width="100%"
                class="sapUiMediumMarginTop sapUiMediumMarginBottom"
                visible="{chartModel>/hasData}">

                <Panel
                    headerText="Budget Breakdown"
                    width="100%"
                    class="sapUiResponsiveMargin sapUiMediumMarginBottom">
                    <!-- Pie chart + a custom clickable/hoverable legend list.
                     now on hover as well as press. -->
                    <HBox wrap="NoWrap" alignItems="Start" width="100%">
                        <viz:VizFrame
                            id="budgetPieChart"
                            uiConfig="{applicationSet:'fiori'}"
                            vizType="pie"
                            height="450px"
                            width="100%"
                            selectData="onSliceSelect"
                            vizProperties="{
                                title: { visible: false },
                                legend: { visible: false },
                                plotArea: {
                                    dataLabel: { visible: true, type: 'value', showTotal: false },
                                    colorPalette: ['#7CB92C','#4EA7F2','#E07B00','#8B5CF6','#17A398','#2B6FDE','#D6249F','#6B7280','#E06666','#6F63E0','#1E3A8A','#B45309']
                                },
                                interaction: { selectability: { mode: 'SINGLE' } }
                            }">
                            <viz:layoutData>
                                <FlexItemData growFactor="1" shrinkFactor="1" />
                            </viz:layoutData>
                            <viz:dataset>
                                <vizdata:FlattenedDataset data="{chartModel>/chartData}">
                                    <vizdata:dimensions>
                                        <vizdata:DimensionDefinition name="Budget Type" value="{chartModel>Category}"/>
                                    </vizdata:dimensions>
                                    <vizdata:measures>
                                        <vizdata:MeasureDefinition name="Amount" value="{chartModel>Value}"/>
                                    </vizdata:measures>
                                </vizdata:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <vizfeed:FeedItem uid="size" type="Measure" values="Amount"/>
                                <vizfeed:FeedItem uid="color" type="Dimension" values="Budget Type"/>
                            </viz:feeds>
                        </viz:VizFrame>

                        <List
                            width="220px"
                            class="sapUiSmallMarginBegin sapUiSmallMarginTop"
                            headerText="Budget Type"
                            items="{chartModel>/chartData}"
                            updateFinished=".onListUpdateFinished">
                            <layoutData>
                                <FlexItemData growFactor="0" shrinkFactor="0" />
                            </layoutData>
                            <items>
                                <CustomListItem type="Active" press=".onLineItemPress">
                                    <HBox alignItems="Center" class="sapUiTinyMargin">
                                        <core:Icon
                                            src="sap-icon://circle-task-2"
                                            color="{chartModel>Color}"
                                            size="0.8rem"
                                            class="sapUiTinyMarginEnd"/>
                                        <Text text="{chartModel>Category}"/>
                                    </HBox>
                                </CustomListItem>
                            </items>
                        </List>
                    </HBox>
                </Panel>

                <Panel
                    headerText="Commitments &amp; Consumption Detail"
                    width="100%"
                    class="sapUiResponsiveMargin sapUiMediumMarginBottom">
                    <viz:VizFrame
                        id="budgetBarChart"
                        uiConfig="{applicationSet:'fiori'}"
                        vizType="bar"
                        height="620px"
                        width="100%"
                        selectData="onBarSelect"
                        vizProperties="{
                            title: { visible: false },
                            plotArea: {
                                dataLabel: { visible: true, type: 'value' },
                                colorPalette: ['#7CB92C','#4EA7F2','#E07B00','#8B5CF6','#17A398','#2B6FDE','#D6249F','#6B7280','#E06666','#6F63E0','#1E3A8A','#B45309']
                            },
                            valueAxis: { title: { visible: true, text: 'Amount' } },
                            categoryAxis: { title: { visible: false } },
                            legend: { visible: true, position: 'bottom', title: { visible: false } },
                            interaction: { selectability: { mode: 'SINGLE' } }
                        }">
                        <viz:dataset>
                            <vizdata:FlattenedDataset data="{chartModel>/barData}">
                                <vizdata:dimensions>
                                    <vizdata:DimensionDefinition name="Item" value="{chartModel>Category}"/>
                                </vizdata:dimensions>
                                <vizdata:measures>
                                    <vizdata:MeasureDefinition name="Amount" value="{chartModel>Value}"/>
                                </vizdata:measures>
                            </vizdata:FlattenedDataset>
                        </viz:dataset>
                        <viz:feeds>
                            <vizfeed:FeedItem uid="valueAxis" type="Measure" values="Amount"/>
                            <vizfeed:FeedItem uid="categoryAxis" type="Dimension" values="Item"/>
                        </viz:feeds>
                    </viz:VizFrame>
                </Panel>

            </l:Grid>

            <!-- Cross-tab line items table: one row per actual line item exactly as
                 returned by the service (not summed), every column pulled straight
                 from OData in this fixed sequence: -->
            <VBox class="sapUiMediumMargin" visible="{chartModel>/hasData}">
                <Title text="All Line Items" class="sapUiSmallMarginBottom"/>

                <ScrollContainer horizontal="true" vertical="false" width="100%">
                    <VBox width="2460px">

                        <ScrollContainer horizontal="false" vertical="true" height="300px" width="2600px">
                            <Table
                                items="{chartModel>/tableRows}"
                                mode="None"
                                width="2460px"
                                sticky="ColumnHeaders">
                                <columns>
                                    <Column width="300px"><Text text="Cost Center / Description"/></Column>
                                    <Column width="300px"><Text text="Company Code / Description"/></Column>
                                    <Column width="150px"><Text text="Department Code"/></Column>
                                    <Column width="150px"><Text text="Currency"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="Available Budget"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="Total Approved Budget"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="C.C Budget"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="IO Budget"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="PR Commitment Stock Item"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="PR Asset"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="PR Commitment Non Stock Item"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="Total PO Non stock Item"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="Total PO stock Item"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="PO Asset"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="Actual Consumption"/></Column>
                                    <Column width="130px" hAlign="End"><Text text="IO Consumption"/></Column>
                                </columns>
                                <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{chartModel>costCenter} - {chartModel>costCenterText}"/>
                                        <Text text="{chartModel>companyCode} - {chartModel>companyName}"/>
                                        <Text text="{chartModel>department}"/>
                                        <Text text="{chartModel>currency}"/>
                                        <Text text="{path:'chartModel>availableBudget', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>totalApprovedBudget', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>ccBudget', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>ioBudget', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>prCommitStock', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>prAsset', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>prCommitNonStock', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>poNonStock', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>poStock', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>poAsset', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>actualConsumption', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <Text text="{path:'chartModel>ioConsumption', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                            </Table>
                        </ScrollContainer>

                        <!-- Pinned Total row -->
                        <Table
                            items="{chartModel>/totalRows}"
                            mode="None"
                            width="2460px"
                            class="totalsTable">
                            <columns>
                                <Column width="300px"><Text text=""/></Column>
                                <Column width="300px"><Text text=""/></Column>
                                <Column width="150px"><Text text=""/></Column>
                                <Column width="150px"><Text text=""/></Column>
                                <Column width="150px"><Text text=""/></Column>
                                <Column width="150px"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                                <Column width="130px" hAlign="End"><Text text=""/></Column>
                            </columns>
                            <items>
                                <ColumnListItem highlight="Success">
                                    <cells>
                                        <Text text="{chartModel>costCenter} - {chartModel>costCenterText}"/>
                                        <Text text="{chartModel>companyCode} - {chartModel>companyName}"/>
                                        <Text text="{chartModel>department}"/>
                                        <Text text="{chartModel>currency}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>availableBudget', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>totalApprovedBudget', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>ccBudget', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>ioBudget', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>prCommitStock', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>prAsset', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>prCommitNonStock', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>poNonStock', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>poStock', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>poAsset', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>actualConsumption', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                        <ObjectNumber emphasized="true" number="{path:'chartModel>ioConsumption', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2, groupingEnabled:true}}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>

                    </VBox>
                </ScrollContainer>
            </VBox>

        </content>
    </Page>

</mvc:View>